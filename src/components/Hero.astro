---
import TegakiText from "./TegakiText.astro";

interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaLink?: string;
}

const {
  title = "We Design Games and Digital Experiences with Identity and Soul",
  subtitle = "Crafting unique games and digital projects that reflect our passion and creativity.",
  ctaText = "Explore Our Work",
  ctaLink = "/proyectos",
} = Astro.props;
---

<section
  class="hero"
  id="hero"
  data-hero
  style="opacity:0; transform:translateY(40px);"
>
  <TegakiText
    text={title}
    as="h1"
    data-hero-title
    fontSize="clamp(2.25rem, 5vw, 3.5rem)"
    speed={1.8}
  />
  <p data-hero-subtitle>{subtitle}</p>
  {
    ctaText && ctaLink && (
      <a href={ctaLink} class="hero-cta" data-hero-cta>
        {ctaText}
      </a>
    )
  }
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const hero = document.querySelector<HTMLElement>("[data-hero]");

  if (!hero) {
    console.warn("Hero: no [data-hero] element found");
  } else if (prefersReduced) {
    hero.style.opacity = "1";
    hero.style.transform = "translateY(0)";
  } else {
    const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

    tl.to(hero, { opacity: 1, y: 0, duration: 1.2 });

    tl.to({}, { duration: 0.15 });

    const subtitleEl = hero.querySelector("[data-hero-subtitle]");
    if (subtitleEl) {
      tl.from(subtitleEl, { opacity: 0, y: 16, duration: 0.7 }, "-=0.2");
    }

    const ctaEl = hero.querySelector("[data-hero-cta]");
    if (ctaEl) {
      tl.from(ctaEl, { opacity: 0, y: 12, duration: 0.6 }, "-=0.2");
    }

    ScrollTrigger.create({
      trigger: hero,
      start: "top top",
      end: "bottom top",
      scrub: true,
      onUpdate: (self) => {
        hero.style.backgroundPositionY = `${-self.progress * 30}px`;
      },
    });
  }
</script>
